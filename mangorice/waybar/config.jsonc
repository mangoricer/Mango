[
    {
        "position": "top",
        "height": 40,
        "spacing": 20,
        "margin-top": 2,
        "margin-bottom": 0,
        "margin-left": 0,
        "margin-right": 0,
        "modules-left": [
            "custom/main",
            "mpris",
            "pulseaudio"
        ],
        "modules-center": [
            "clock"
        ],
        "modules-right": [
            "custom/bar-wifi",
            "network",
            "bluetooth",
            "battery"
        ],
        "hyprland/workspaces": {
            "format": "{id}",
            "on-scroll-up": "",
            "on-scroll-down": "",
            "persistent-workspaces": {
                "*": [
                    1,
                    2,
                    3,
                    4,
                    5
                ]
            },
            "anim-color-1": "#89b4fa",
            "anim-color-2": "#cba6f7",
            "anim-duration": 3,
            "button-radius": 5,
            "button-pad-v": 0,
            "button-pad-h": 4,
            "button-minw": 35,
            "_inverted": false,
            "justify": "center"
        },
        "hyprland/window": {
            "format": "{}",
            "max-length": 74,
            "separate-outputs": true,
            "_inverted": false
        },
        "clock": {
            "format": " {:%H:%M} ",
            "timezone": "Russia/Ufa",
            "locale": "ru_RU.utf8",
            "interval": 1,
            "on-click": "flatpak run com.ml4w.calendar",
            "tooltip": true,
            "_inverted": true
        },
        "cpu": {
            "format": "󰍛 {usage}%",
            "tooltip": true,
            "interval": 2,
            "_inverted": false
        },
        "memory": {
            "format": "󰾆 {used:0.1f}G",
            "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G",
            "interval": 5
        },
        "disk": {
            "format": "<span font='JetBrainsMono Nerd Font Mono 12'>󰋊</span> {percentage_used}%",
            "path": "/",
            "interval": 30,
            "tooltip": true,
            "_inverted": false
        },
        "network": {
            "format-wifi": "{essid}",
            "format-ethernet": "eblan",
            "format-disconnected": "WiFi",
            "tooltip-format": "{ifname} via {gwaddr}",
            "on-click": "nm-connection-editor",
            "interval": 5,
            "_inverted": false
        },
        "bluetooth": {
            "format": " 󰂱 ",
            "format-disabled": "   ",
            "format-connect": "{num_connections}",
            "tooltip-format": "{controller_alias}\t{controller_address}",
            "format-connected": " 󰂱 {device_alias} ",
            "on-click": "/usr/bin/blueman-manager",
            "interval": 30,
            "tooltip": true,
            "_inverted": true
        },
        "pulseaudio": {
            "format": "{icon} {volume}%",
            "format-muted": "󰝟 mute",
            "format-icons": {
                "default": [
                    "󰕿",
                    "󰖀",
                    "󰕾"
                ]
            },
            "on-click": "pavucontrol",
            "scroll-step": 5,
            "_inverted": false
        },
        "wireplumber": {
            "format": "<span font='JetBrainsMono Nerd Font Mono 12'>󰕾</span> {volume}%",
            "format-muted": "<span font='JetBrainsMono Nerd Font Mono 12'>󰝟</span> mute",
            "on-click": "pavucontrol",
            "scroll-step": 5,
            "_inverted": false
        },
        "battery": {
            "format": "{icon} {capacity}%",
            "format-icons": [
                "󰁺",
                "󰁼",
                "󰁾",
                "󰂀",
                "󰂂",
                "󰁹"
            ],
            "format-charging": "󰂄 {capacity}%",
            "format-plugged": "󰚥 {capacity}%",
            "states": {
                "warning": 30,
                "critical": 15
            },
            "_inverted": false
        },
        "backlight": {
            "format": "{icon} {percent}%",
            "on-scroll-up": "brightnessctl set 5%+",
            "on-scroll-down": "brightnessctl set 5%-",
            "_inverted": false
        },
        "idle_inhibitor": {
            "format": "<span font='JetBrainsMono Nerd Font Mono 12'>{icon}</span>",
            "format-icons": {
                "activated": "󰾪",
                "deactivated": "󰾩"
            },
            "_inverted": false
        },
        "mpris": {
            "format": "{player_icon} {artist} - {title}",
            "format-paused": "{player_icon}  {artist} - {title}",
            "interval": 1,
            "max-length": 40,
            "_inverted": false
        },
        "privacy": {
            "icon-size": 18,
            "icon-spacing": 4,
            "transition-duration": 250,
            "_inverted": false
        },
        "tray": {
            "spacing": 8,
            "icon-size": 18
        },
        "wlr/taskbar": {
            "format": "{icon}",
            "on-click": "activate",
            "on-click-middle": "close",
            "icon-size": 18,
            "tooltip": true,
            "_inverted": false
        },
        "custom/arch": {
            "format": "<span font='JetBrainsMono Nerd Font Mono 20' color='#88c0d0'>󰣇</span>",
            "on-click": "$HOME/.local/bin/vsfetch",
            "tooltip": true,
            "arch-icon-glyph": "󰣇",
            "arch-pad-left": 5,
            "arch-pad-right": 5,
            "_inverted": false
        },
        "custom/weather": {
            "format": "{}",
            "exec": "$HOME/.config/waybar/scripts/weather.py",
            "return-type": "json",
            "interval": 3600,
            "tooltip": true,
            "on-click": "flatpak run io.github.amit9838.mousam",
            "_inverted": false
        },
        "custom/updates": {
            "exec": "count=$(checkupdates 2>/dev/null | wc -l); [ \"$count\" -gt 0 ] && echo '{\"text\":\"󰚰 '\"$count\"'\",\"class\":\"pending\"}' || echo '{\"text\":\"󰚰 0\",\"class\":\"updated\"}'",
            "return-type": "json",
            "interval": 60,
            "tooltip": false,
            "on-click": "kitty --class floating-terminal -e ~/.config/hypr/scripts/install-updates.sh",
            "_inverted": false
        },
        "custom/swaync": {
            "format": "<span font='JetBrainsMono Nerd Font Mono 16'>{icon}</span>",
            "format-icons": {
                "none": "󰂚",
                "notification": "󰂜",
                "dnd-none": "󰂛",
                "dnd-notification": "󰂛"
            },
            "return-type": "json",
            "exec-if": "which swaync-client",
            "exec": "swaync-client -swb",
            "on-click": "swaync-client -t -sw",
            "on-click-right": "swaync-client -d -sw",
            "escape": true,
            "tooltip": false
        },
        "custom/power": {
            "format": "⏻",
            "on-click": "wlogout -b 3 -c 20 -r 20 -L 400 -R 400 -T 200 -B 200 --protocol layer-shell",
            "tooltip": false,
            "_inverted": false
        },
        "custom/settings": {
            "format": "󰒓",
            "on-click": "vswaybar-studio",
            "tooltip": false,
            "_inverted": false
        },
        "custom/claudebar": {
            "exec": "claudebar --format '{session_bar} {session_pct}% · {session_reset}'",
            "return-type": "json",
            "interval": 30,
            "signal": 13,
            "tooltip": true,
            "on-click": "xdg-open https://claude.ai/settings/usage",
            "_inverted": false
        },
        "custom/bar-cpu": {
            "exec": "$HOME/.config/waybar/scripts/vsbar.py --type cpu",
            "return-type": "json",
            "interval": 2,
            "tooltip": true,
            "_inverted": false
        },
        "custom/bar-mem": {
            "exec": "$HOME/.config/waybar/scripts/vsbar.py --type mem",
            "return-type": "json",
            "interval": 5,
            "tooltip": true
        },
        "custom/bar-vol": {
            "exec": "$HOME/.config/waybar/scripts/vsbar.py --type vol",
            "return-type": "json",
            "interval": 2,
            "tooltip": true,
            "on-click": "pavucontrol"
        },
        "custom/bar-wifi": {
            "exec": "$HOME/.config/waybar/scripts/vsbar.py --type wifi",
            "return-type": "json",
            "interval": 5,
            "tooltip": true,
            "on-click": "nm-connection-editor",
            "_inverted": false
        },
        "custom/player": {
            "format": "󰝚",
            "tooltip": false,
            "on-click": "noop",
            "menu": "on-click",
            "menu-file": "/home/ellio/.config/waybar/player_menu.xml",
            "menu-actions": {
                "item": "playerctl play",
                "item_1": "playerctl pause",
                "item_2": "playerctl next",
                "item_3": "playerctl previous"
            }
        },
        "custom/main": {
            "format": "󰮯",
            "tooltip": false,
            "on-click": "noop",
            "menu": "on-click",
            "menu-file": "/home/ellio/.config/waybar/main_menu.xml",
            "menu-actions": {
                "item_1": "powerprofilesctl set performance",
                "item_2": "powerprofilesctl set balanced",
                "item_3": "powerprofilesctl set power-saver",
                "item_4": "shutdown now",
                "item": "reboot"
            }
        },
        "name": "bar",
        "dwl/tags": {
            "num-tags": 9,
            "format": "{name}"
        }
    }
]
